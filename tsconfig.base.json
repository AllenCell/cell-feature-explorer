{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "downlevelIteration": true,
        "jsx": "react",
        "lib": ["DOM", "ES2015", "ES6", "DOM.Iterable", "ScriptHost"],
        "moduleResolution": "Node",
        "noEmit": true,
        "noImplicitAny": true,
        "preserveConstEnums": true,
        "skipLibCheck": true,
        "strict": true,
        "module": "ES2022",
        "target": "ES2020"
    },
    "include": ["typings/**/*", "src/**/*"]
}
